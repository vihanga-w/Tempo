{
  "name": "distributed-db",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node ./build/index.js",
    "dev": "npx tsc && node ./build/index.js",
    "create-docker-volume": "docker volume create --name TempoDatabases",
    "inspect-fs": "docker run -ti --rm -v TempoDatabases:/tempodb ubuntu",
    "list-fs": "docker volume ls",
    "backup-fs": "docker run --rm -v TempoDatabases:/data -v ~/tempo-bak:/backup ubuntu tar cvf /backup/backup.tar /data",
    "dcu": "docker-compose up -d --build"
  },
  "keywords": [],
  "author": "",
