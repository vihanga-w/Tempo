  "packageManager": "pnpm@10.6.5",
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/express": "^5.0.1",
    "@types/ncp": "^2.0.8",
    "@types/node": "^22.14.1",
    "acebase": "^1.29.5",
    "axios": "^1.9.0",
    "body-parser": "^2.2.0",
    "express": "^5.1.0",
    "fast-json-stable-stringify": "^2.1.0",
    "ncp": "^2.0.0"
  }
