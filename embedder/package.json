{
  "name": "embedder",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "dev::process": "npx tsc && node ./build/process.js",
    "dev::ae": "npx tsc && node ./build/autoencoder.js",
    "dev::process+ae": "npx tsc && node ./build/process.js && node ./build/autoencoder.js",
    "dev::utaste": "npx tsc && node ./build/user-taste.js",
    "dev::spotify": "npx tsc && node ./build/spotify.js",
    "process-unknown-songs": "npx tsc && node ./build/unknown-songs.js && node ./build/create-playlist.js",
    "mdt": "npx tsc && node ./build/match-downloaded-tracks.js",
    "test::taste": "npx tsc && node ./build/test-taste.js",
    "start": "node ./build/spotify.js",
    "dcu": "docker-compose up -d --build",
    "test": "npx tsc && node --env-file=.env.test --test build/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "async-mutex": "^0.5.0",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-slow-down": "^2.0.3",
    "express-ws": "^5.0.2",
    "fastest-levenshtein": "^1.0.16",
    "he": "^1.2.0",
    "jsonwebtoken": "^9.0.2",
    "node-id3": "^0.2.8",
    "object-hash": "^3.0.0",
    "prompt-sync": "^4.2.0",
    "spotify-web-api-node": "^5.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.18.1",
    "mongodb": "^6.13.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/express-ws": "^3.0.5",
    "@types/he": "^1.2.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/object-hash": "^3.0.6",
    "@types/prompt-sync": "^4.2.3",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.7.3",
    "@types/spotify-web-api-node": "^5.0.11",
    "@types/ws": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
