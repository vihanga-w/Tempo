{
  "name": "embedder",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "dev::process": "npx tsc && node ./build/process.js",
    "dev::ae": "npx tsc && node ./build/autoencoder.js",
    "dev::process+ae": "npx tsc && node ./build/process.js && node ./build/autoencoder.js",
    "dev::utaste": "npx tsc && node ./build/user-taste.js",
    "dev::spotify": "npx tsc && node ./build/spotify.js",
    "process-unknown-songs": "npx tsc && node ./build/unknown-songs.js && node ./build/create-playlist.js",
    "mdt": "npx tsc && node ./build/match-downloaded-tracks.js",
    "create-emb-idx": "npx tsc && node ./build/create-embeddings-index.js",
    "test::taste": "npx tsc && node ./build/test-taste.js",
    "start": "node ./build/spotify.js",
    "dcu": "docker-compose up -d --build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
