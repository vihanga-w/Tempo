    "audio-decode": "^2.2.2",
    "body-parser": "^1.20.3",
    "cli-progress": "^3.12.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-slow-down": "^2.0.3",
    "express-ws": "^5.0.2",
    "fastest-levenshtein": "^1.0.16",
    "fft.js": "^4.0.4",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.2",
    "meyda": "^5.6.3",
    "music-metadata": "^11.0.0",
    "music-tempo": "^1.0.3",
    "ncp": "^2.0.0",
    "node-id3": "^0.2.8",
    "node-wav": "^0.0.2",
    "prompt-sync": "^4.2.0",
    "spotify-web-api-node": "^5.0.2",
