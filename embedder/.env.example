# GitHub token with read access to the repository. Read by setup.sh to clone
# and update the deployment; not used by the server itself.
GH_TOKEN=

# Copy to .env and fill in. Never commit .env.
#
# Every value here is required — the server refuses to start without them and
# names the ones it is missing.

NODE_ENV=development

# Public origin of this API (no trailing slash).
# Production: https://tempo-be.vihangaw.xyz
BASE_URL=http://localhost:2246

# Public origin of the web app, used for post-auth redirects (no trailing slash).
# Production: https://tempo.vihangaw.xyz
WEB_APP_URL=http://localhost:3000

# The `sub` claim on VAPID push JWTs — a mailto: or http(s) URL a push service
# can use to reach you. Optional; defaults to WEB_APP_URL.
# VAPID_SUBJECT=mailto:you@example.com

# Notifications for the installed iOS app, which cannot receive web push.
# All three are needed together; leave them unset and the server notifies
# browsers only. The Key ID and Team ID come from the Apple developer account,
# and the topic is the app's bundle id.
#
# The .p8 itself is never in the repo. Copy it into the keys volume on the
# server, beside the signing keys:
#
#   docker compose cp AuthKey_<KEY_ID>.p8 app:/app/keys/
#
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=xyz.vihangaw.tempo
# Optional; defaults to ./keys/AuthKey_<APNS_KEY_ID>.p8
# APNS_KEY_PATH=

# Domain the auth cookie is scoped to.
# Production: .vihangaw.xyz     Local: localhost
# The API and the web app sit on sibling subdomains, so the cookie has to be
# scoped to the parent they share, not to either host.
COOKIE_DOMAIN=localhost

# Comma-separated CORS allowlist.
# Production: https://tempo.vihangaw.xyz,capacitor://localhost
ALLOWED_ORIGINS=http://localhost:3000,capacitor://localhost

# Spotify app credentials. Use a separate app for dev and prod, and make sure
# BASE_URL + /spotify/callback is registered as a redirect URI on the app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OPTIONAL. YouTube Data API v3 key, used only to find music videos to play
# behind friends' listening activity. Leave unset to disable that feature — the
# endpoint then answers 404 and the client renders without a background video.
# Restrict the key by IP or referrer in the Cloud console if you do set it.
# YOUTUBE_API_KEY=

# Set to false to disable music video backgrounds while keeping the key above.
# MUSIC_VIDEO_ENABLED=true

# Cloudflare R2, where converted album art and profile pictures are stored.
# Create an R2 API token with Object Read & Write scoped to the bucket, and give
# the bucket a public custom domain for R2_PUBLIC_URL.
# Full S3 API endpoint. Note the jurisdiction segment — EU buckets are
#   https://<account-id>.eu.r2.cloudflarestorage.com
# and default-jurisdiction buckets omit the ".eu".
R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tempo-images

# OPTIONAL. Public origin for the bucket (custom domain or r2.dev subdomain).
# Leave unset until public access is enabled: the API then streams image bytes
# itself. Once set, the API redirects instead and stops serving bytes at all.
# Must NOT be the R2_ENDPOINT above — that needs signed requests.
# R2_PUBLIC_URL=https://img.vihangaw.xyz

# MongoDB. Local compose brings up a mongo service as "mongo"; for Atlas use the
# full SRV string, e.g. mongodb+srv://user:pass@cluster.xxxxx.mongodb.net
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=tempo

PORT=2246

# Verbose logging, including the console.verbose perf timers.
VERBOSE_MODE=false

# Load song and album embeddings at boot. Off by default — discovery is hidden
# in the client, so nothing reads them, and loading warns once per file it cannot
# find. Turn on when discovery returns.
# EMBEDDINGS_ENABLED=true

# Skip the startup bootstrap (auth scan, embeddings, notifications). Dev only.
SKIP_BOOTSTRAP=false

# Treat every request as an authenticated fake user. Dev only — this is forced
# off whenever NODE_ENV=production, regardless of what is set here.
BYPASS_AUTH=false

# Seeds a synthetic friend who is permanently "listening", so the friends list
# and live playback UI can be tested without a second real Spotify account.
# Forced off whenever NODE_ENV=production.
# DEV_FAKE_FRIEND=false

# --- Passport ---------------------------------------------------------------
# Artist origins are resolved from MusicBrainz on a timer, one request a second.
# Set to false to stop the service talking to MusicBrainz at all; the passport
# then reports only the artists already resolved.
PASSPORT_RESOLVER_ENABLED=true

# Optional. Groq phrases the sentence under a destination that has already been
# chosen from the data -- it never picks the destination. Without a key the
# destination still works and explains itself from a template.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
